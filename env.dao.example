# DAO Governance Co-pilot Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: AI Model API Keys
# =============================================================================

# Google Gemini API Key (Required for ADK-TS)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL: Alternative AI Providers
# =============================================================================

# OpenAI API Key (Optional - if using GPT models)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Optional - if using Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# =============================================================================
# OPTIONAL: Blockchain Configuration
# =============================================================================

# Ethereum RPC URL (for production blockchain integration)
# Get Infura key at: https://infura.io/
# ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_project_id

# Alternative RPC providers:
# ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_api_key
# ETHEREUM_RPC_URL=https://rpc.ankr.com/eth

# =============================================================================
# OPTIONAL: DAO-Specific Configuration
# =============================================================================

# Default DAO Governance Contract Address
# DAO_GOVERNANCE_CONTRACT=0x0000000000000000000000000000000000000000

# Default DAO Token Contract Address
# DAO_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000

# Default Treasury Address
# DAO_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# =============================================================================
# OPTIONAL: Advanced Configuration
# =============================================================================

# Log Level (debug, info, warn, error)
# LOG_LEVEL=info

# Enable verbose logging for agents
# AGENT_VERBOSE=true

# Cache TTL in seconds (for proposal data)
# CACHE_TTL=300

# Maximum concurrent agent executions
# MAX_CONCURRENT_AGENTS=3

# =============================================================================
# NOTES
# =============================================================================
# 
# 1. SECURITY: Never commit your .env file to version control
# 2. REQUIRED: Only GOOGLE_API_KEY is required for basic functionality
# 3. BLOCKCHAIN: RPC URL only needed for production blockchain integration
# 4. TESTING: Use mock data initially, add real contracts later
# 5. MODELS: Gemini 2.0 Flash is recommended for best performance/cost
#
# For detailed setup instructions, see: DAO_QUICK_START.md
# For full documentation, see: DAO_ADK_IMPLEMENTATION_GUIDE.md

