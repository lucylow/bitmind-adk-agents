# DAO Governance Co-pilot Environment Configuration
# Copy this file to .env.local and fill in your values

# Blockchain RPC Configuration
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
CHAIN_ID=1

# The Graph Configuration
GRAPH_ENDPOINT=https://api.thegraph.com/subgraphs/name/graphprotocol/compound-governance
GRAPH_API_KEY=

# Governance Platform APIs
SNAPSHOT_HUB=https://hub.snapshot.org/graphql
DEFAULT_SNAPSHOT_SPACE=compound.eth
TALLY_API_KEY=
TALLY_API_URL=https://api.tally.xyz/query

# AI/LLM Configuration
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ENABLE_AI_RISK_ANALYSIS=false

# Risk Assessment Thresholds
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.8

# MCP Server Configuration
CACHE_ENABLED=true
CACHE_TTL=300
MAX_RETRIES=3
RETRY_DELAY=1000

# DAO Configuration
DEFAULT_DAO_ADDRESS=0xc0Da02939E1441F497fd74F78cE7Decb17B66529

# Agent Configuration
ENABLE_AUDIT_LOGGING=true
ENABLE_GUARDRAILS=true
REQUIRE_HIGH_RISK_APPROVAL=true

