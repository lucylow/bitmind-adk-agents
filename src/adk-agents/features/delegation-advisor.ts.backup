    communicationQuality: 0.88,
    responsiveness: 0.92,
    riskProfile: 'moderate'
  }],
  ['delegate-002', {
    address: 'SP2X002...DEF',
    name: 'Community Builder',
    participationRate: 0.87,
    votingPower: 3200000,
    proposalsVoted: 98,
    proposalsCreated: 15,
    specializations: ['community', 'grants', 'governance'],
    communicationQuality: 0.95,
    responsiveness: 0.89,
    riskProfile: 'conservative'
  }],
  ['delegate-003', {
    address: 'SP2X003...GHI',
    name: 'Protocol Architect',
    participationRate: 0.91,
