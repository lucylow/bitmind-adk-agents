/**
 * Delegation Advisor Feature
 * Helps users make informed delegation decisions and optimize their governance participation
 */

import { AgentBuilder, BaseTool, Agent } from '../core/agent-builder';
import { z } from 'zod';

// Types and Interfaces
export interface DelegateProfile {
  address: string;
  name?: string;
  participationRate: number; // 0-1
  votingPower: number;
  proposalsVoted: number;
  proposalsCreated: number;
  alignmentScore?: number; // 0-1, calculated against user preferences
  specializations: string[];
  communicationQuality: number; // 0-1
  responsiveness: number; // 0-1
  riskProfile: 'conservative' | 'moderate' | 'aggressive';
  performance: DelegatePerformance;
}

export interface DelegatePerformance {
  participationRate: number;
  proposalSuccessRate: number; // % of their votes that aligned with outcome
  communicationScore: number;
  consistencyScore: number;
  recentActivity: number; // Proposals voted in last 30 days
  delegatorCount: number;
  totalDelegatedPower: number;
}

export interface DelegationRecommendation {
  delegate: DelegateProfile;
  matchScore: number; // 0-100
  matchReasons: string[];
  strengths: string[];
  concerns: string[];
  suggestedAmount?: number; // % of voting power to delegate
}

export interface DelegationStrategy {
  approach: 'single' | 'diversified' | 'hybrid';
  recommendations: DelegationRecommendation[];
  rationale: string;
  riskLevel: string;
  expectedOutcome: string;
}

