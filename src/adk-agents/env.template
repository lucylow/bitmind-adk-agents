# BitMind DAO Governance Co-pilot - Environment Variables
# Copy this file to .env and fill in your actual values

# AI Model API Keys
GEMINI_API_KEY=your_gemini_api_key_here

# Blockchain RPC Endpoints (Optional - for real blockchain data)
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_key

# The Graph API (Optional - for querying DAO data)
THEGRAPH_API_KEY=your_thegraph_api_key

# Application Configuration
NODE_ENV=development
DEBUG=true
AGENT_TIMEOUT=30000

# Security
ENABLE_VOTE_EXECUTION=false
REQUIRE_MANUAL_APPROVAL=true

